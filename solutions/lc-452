class Solution {
public:
    int findMinArrowShots(vector<vector<int>>& points) {
        sort(points.begin(), points.end(), [](vector<int>& a, vector<int>& b) {
            return a[1] < b[1];
        });

        int count = 0;

        long long last = -(1LL << 60);

        for (auto& i : points) {
            int start = i[0];
            int end = i[1];

            if (start > last) {
                count++;
                last = end;
            }
        }
        return count;
    }
};