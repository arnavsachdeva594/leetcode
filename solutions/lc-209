class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        int n = nums.size();

        vector<long long> prefixSum(n+1);
        for (int i = 0; i < n; ++i){
            prefixSum[i+1] = prefixSum[i] + nums[i];
        }

        int minlength = n + 1;

        for (int i = 0; i <= n; ++i){
            int left = i;
            int right = n;
            int trueindex = -1;

            while (left <= right) {
                int mid = left + (right - left) / 2;
                if (prefixSum[mid] >= prefixSum[i] + target) {
                    trueindex = mid;
                    right = mid - 1;
                } else {
                    left = mid + 1;
                }
            }

            if (trueindex != -1) {
                minlength = min(minlength, trueindex - i);
            }
        }
        return minlength <= n ? minlength : 0;
    }
};