class Solution {
public:
    int maxArea(vector<int>& height) {
        int l =0;
        int r = height.size() - 1;
        int maxwater = 0;

        while (l < r) {
            int current = min(height[l], height[r]) * (r - l);

            maxwater = max(maxwater, current);

            if (height[l] < height[r]) {
                ++l;
            } else {
                --r;
            }
        }
        return maxwater;
    }
};