class Solution {
public:
    int canCompleteCircuit(vector<int>& gas, vector<int>& cost) {
        int n = gas.size();

        int i = -1;
        int tank = 0;
        int location = 0;

        while (location < n * 2) {
            if (i == -1){
                i = location;
            }
            
            tank += gas[location % n] - cost[location % n];

            if (tank < 0) {
                i = -1;
                tank = 0;
            }

            location++;

            if (i != -1 && location - i == n) {
                return i % n;
            }
        }
        return -1;
    }
};