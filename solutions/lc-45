class Solution {
public:
    int jump(vector<int>& nums) {
        int count = 0;
        int maxreach = 0;
        int current = 0;

        for (int i = 0; i < nums.size() - 1; ++i){
            maxreach = max(maxreach, i + nums[i]);

            if (i == current){
                ++count;
                current = maxreach;
            }
        }
        return count;
    }
};