class RandomizedSet {
public:
    RandomizedSet() {
        
    }
    
    bool insert(int val) {
        if (valueToIndex.count(val)) {
            return false;
        }

        valueToIndex[val] = values.size();
        values.push_back(val);
        return true;
    }
    
    bool remove(int val) {
        if (!valueToIndex.count(val)) {
            return false;
        }

        int indexToRemove = valueToIndex[val];
        int last = values.back();

        values[indexToRemove] = last;
        valueToIndex[last] = indexToRemove;

        values.pop_back();
        valueToIndex.erase(val);
        return true;
    }
    
    int getRandom() {
        return values[rand() % values.size()];
    }


private:
    unordered_map<int, int> valueToIndex;

    vector<int> values;
};
