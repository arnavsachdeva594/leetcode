class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int maxprofit = 0;
        int minprice = prices[0];

        for (int& current : prices) {
            maxprofit = max(maxprofit, current - minprice);
            minprice = min(minprice, current);
        }
        return maxprofit;
    }
};